<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.krisner94</groupId>
    <artifactId>harpia-arch</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Harpia Arch</name>
    <description>Contract-first OpenAPI code generation configuration for Quarkus applications.</description>
    <url>https://github.com/Krisner94/Harpia-Arch</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Krisner94</id>
            <name>Rhama Krisner</name>
            <email>rhamakrisner@gmail.com</email>
            <url>https://github.com/Krisner94</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/Krisner94/Harpia-Arch.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Krisner94/Harpia-Arch.git</developerConnection>
        <url>https://github.com/Krisner94/Harpia-Arch</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>harpia-core</module>
        <module>harpia-core-deployment</module>
        <module>harpia-quarkus</module>
        <module>harpia-integration-tests</module>
        <module>harpia-benchmarks</module>
    </modules>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.version>3.40.1.1</quarkus.version>
        <openapi-generator.version>7.4.0</openapi-generator.version>
        <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>

        <!-- Central Portal publishing (consumed by the release profile) -->
        <central.autoPublish>true</central.autoPublish>
        <central.waitUntil>published</central.waitUntil>
        <central.waitMaxTime>3600</central.waitMaxTime>
        <gpg.skip>false</gpg.skip>

        <!-- OpenAPI contract generation -->
        <harpia.openapi.spec>${project.basedir}/src/main/resources/openapi/openapi.yaml</harpia.openapi.spec>
        <harpia.openapi.api-package>${project.groupId}.api</harpia.openapi.api-package>
        <harpia.openapi.model-package>${harpia.openapi.api-package}.beans</harpia.openapi.model-package>
        <harpia.openapi.api-suffix>Api</harpia.openapi.api-suffix>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.krisner94</groupId>
                <artifactId>harpia-core</artifactId>
                <!-- Literal de propósito: um parent publicado e herdado por aplicações
                     resolve ${project.version} no contexto do app consumidor. Mantido
                     em sincronia pelo versions:set nos workflows. -->
                <version>1.0.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                        <maven.repo>${settings.localRepository}</maven.repo>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>harpia-openapi-codegen</id>
            <activation>
                <file>
                    <exists>src/main/resources/openapi</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openapitools</groupId>
                        <artifactId>openapi-generator-maven-plugin</artifactId>
                        <version>${openapi-generator.version}</version>
                        <executions>
                            <execution>
                                <id>harpia-generate-code-from-openapi</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <inputSpec>${harpia.openapi.spec}</inputSpec>
                                    <generatorName>jaxrs-spec</generatorName>
                                    <output>${project.build.directory}/generated-sources/openapi</output>
                                    <apiPackage>${harpia.openapi.api-package}</apiPackage>
                                    <modelPackage>${harpia.openapi.model-package}</modelPackage>
                                    <apiNameSuffix>${harpia.openapi.api-suffix}</apiNameSuffix>
                                    <generateSupportingFiles>false</generateSupportingFiles>
                                    <configOptions>
                                        <dateLibrary>java8</dateLibrary>
                                        <interfaceOnly>true</interfaceOnly>
                                        <interfaceOnly>true</interfaceOnly>
                                        <sourceFolder>src/main/java</sourceFolder>
                                        <useJakartaEe>true</useJakartaEe>
                                        <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                        <useMicroProfileOpenAPIAnnotations>true</useMicroProfileOpenAPIAnnotations>
                                        <useBeanValidation>true</useBeanValidation>
                                        <useTags>false</useTags>
                                    </configOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>harpia-add-openapi-source-root</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.build.directory}/generated-sources/openapi/src/main/java
                                        </source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <release>${maven.compiler.release}</release>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>${central.waitUntil}</waitUntil>
                            <waitMaxTime>${central.waitMaxTime}</waitMaxTime>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
